    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Create a DRAFT proposal (not visible to the client, costs nothing). Use dry_run=true\n        first to preview the payload and its Connects cost.",
      "inputSchema": {
        "properties": {
          "bid_amount": {
            "description": "USD; hourly rate for hourly jobs",
            "exclusiveMinimum": 0,
            "maximum": 100000,
            "title": "Bid Amount",
            "type": "number"
          },
          "cover_letter": {
            "maxLength": 5000,
            "minLength": 50,
            "title": "Cover Letter",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "description": "If true, validate and preview only; nothing is sent.",
            "title": "Dry Run",
            "type": "boolean"
          },
          "idempotency_key": {
            "description": "Unique per intended action, e.g. '<thread_id>:v<draft_version>'. Reuse it on retries.",
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9:_.\\-]+$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "job_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-]+$",
            "title": "Job Id",
            "type": "string"
          },
          "screening_answers": {
            "anyOf": [
              {
                "additionalProperties": {
                  "maxLength": 1500,
                  "type": "string"
                },
                "maxProperties": 10,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Screening Answers"
          }
        },
        "required": [
          "job_id",
          "cover_letter",
          "bid_amount",
          "idempotency_key"
        ],
        "title": "create_proposal_draftArguments",
        "type": "object"
      },
      "name": "create_proposal_draft",
      "outputSchema": {
        "properties": {
          "connects_cost": {
            "title": "Connects Cost",
            "type": "integer"
          },
          "dry_run": {
            "title": "Dry Run",
            "type": "boolean"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "proposal_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Draft id (None on dry_run)",
            "title": "Proposal Id"
          },
          "replayed": {
            "default": false,
            "title": "Replayed",
            "type": "boolean"
          },
          "would_send": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Would Send"
          }
        },
        "required": [
          "dry_run",
          "job_id",
          "connects_cost"
        ],
        "title": "DraftToolResult",
        "type": "object"
      },
      "title": "Create proposal draft"
    },
