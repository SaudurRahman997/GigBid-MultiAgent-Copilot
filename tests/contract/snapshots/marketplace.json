        "readOnlyHint": false
      },
      "description": "Send a draft to the client and SPEND Connects. Irreversible. Only call after a human\n        approved this exact draft. Retries with the same idempotency_key never charge twice.",
      "inputSchema": {
        "properties": {
          "dry_run": {
            "default": false,
