{
  "prompts": [
    {
      "arguments": [
        "question"
      ],
      "name": "answer_screening_question"
    },
    {
      "arguments": [
        "job"
      ],
      "name": "cover_letter_opening"
    },
    {
      "arguments": [
        "skill"
      ],
      "name": "summarise_experience"
    }
  ],
  "resource_templates": [
    "portfolio://case/{id}",
    "portfolio://proposal/{id}",
    "portfolio://repo/{name}"
  ],
  "server": "portfolio",
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Full text and metadata of one case study.",
      "inputSchema": {
        "properties": {
          "id": {
            "description": "Evidence id, e.g. ai_ml:case:03",
            "maxLength": 80,
            "minLength": 3,
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "get_case_studyArguments",
        "type": "object"
      },
      "name": "get_case_study",
      "outputSchema": {
        "properties": {
          "client_industry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Industry"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "title": "Skills",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "date",
          "client_industry",
          "outcome",
          "project_id",
          "skills",
          "text"
        ],
        "title": "CaseStudy",
        "type": "object"
      },
      "title": "Get case study"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Skills evidenced in the portfolio, with how many evidence items support each.",
      "inputSchema": {
        "properties": {},
        "title": "list_skillsArguments",
        "type": "object"
      },
      "name": "list_skills",
      "outputSchema": {
        "$defs": {
          "SkillCount": {
            "properties": {
              "evidence_count": {
                "title": "Evidence Count",
                "type": "integer"
              },
              "skill": {
                "title": "Skill",
                "type": "string"
              }
            },
            "required": [
              "skill",
              "evidence_count"
            ],
            "title": "SkillCount",
            "type": "object"
          }
        },
        "properties": {
          "persona": {
            "title": "Persona",
            "type": "string"
          },
          "skills": {
            "items": {
              "$ref": "#/$defs/SkillCount"
            },
            "title": "Skills",
            "type": "array"
          }
        },
        "required": [
          "persona",
          "skills"
        ],
        "title": "SkillsResult",
        "type": "object"
      },
      "title": "List skills"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Find portfolio evidence (case studies, reviews, READMEs, code, CV, past proposals)\n        that supports ONE requirement. Query once per requirement for best results.",
      "inputSchema": {
        "$defs": {
          "EvidenceFilters": {
            "properties": {
              "date_from": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "ISO date; only evidence on/after it",
                "title": "Date From"
              },
              "outcomes": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "e.g. won, replied (proposals) - substring match",
                "title": "Outcomes"
              },
              "skills": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Keep items tagged with any of these skills",
                "title": "Skills"
              },
              "types": {
                "anyOf": [
                  {
                    "items": {
                      "enum": [
                        "case_study",
                        "review",
                        "readme",
                        "code",
                        "cv",
                        "proposal"
                      ],
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Only these evidence types",
                "title": "Types"
              }
            },
            "title": "EvidenceFilters",
            "type": "object"
          }
        },
        "properties": {
          "filters": {
            "anyOf": [
              {
                "$ref": "#/$defs/EvidenceFilters"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "k": {
            "default": 5,
            "maximum": 20,
            "minimum": 1,
            "title": "K",
            "type": "integer"
          },
          "requirement": {
            "description": "One job requirement, in the client's words",
            "maxLength": 500,
            "minLength": 3,
            "title": "Requirement",
            "type": "string"
          }
        },
        "required": [
          "requirement"
        ],
        "title": "search_evidenceArguments",
        "type": "object"
      },
      "name": "search_evidence",
      "outputSchema": {
        "$defs": {
          "EvidenceItem": {
            "properties": {
              "date": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Date"
              },
              "id": {
                "title": "Id",
                "type": "string"
              },
              "outcome": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "e.g. 'rated 5.0/5; rehired', '4.8/5', 'won'",
                "title": "Outcome"
              },
              "project_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Project Id"
              },
              "score": {
                "title": "Score",
                "type": "number"
              },
              "snippet": {
                "title": "Snippet",
                "type": "string"
              },
              "source": {
                "description": "File inside the persona's portfolio",
                "title": "Source",
                "type": "string"
              },
              "title": {
                "title": "Title",
                "type": "string"
              },
              "type": {
                "title": "Type",
                "type": "string"
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "source",
              "snippet",
              "score"
            ],
            "title": "EvidenceItem",
            "type": "object"
          }
        },
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/EvidenceItem"
            },
            "title": "Items",
            "type": "array"
          },
          "variant": {
            "description": "Retrieval variant that produced the ranking",
            "title": "Variant",
            "type": "string"
          }
        },
        "required": [
          "variant",
          "items"
        ],
        "title": "EvidenceSearchResult",
        "type": "object"
      },
      "title": "Search portfolio evidence"
    }
  ]
}
