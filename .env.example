# Copy to .env and fill in. Never commit .env.
# ---------- Postgres / Redis ----------
POSTGRES_USER=gigbid
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gigbid
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gigbid:change-me@localhost:5432/gigbid
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- Tracing (Arize Phoenix) ----------
PHOENIX_UI_PORT=6006
PHOENIX_GRPC_PORT=4317
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
OTEL_SERVICE_NAME=gigbid

# ---------- Kaggle (Phase 1, your own token) ----------
# New-style token (KGAT_...) from kaggle.com > Settings > API. Legacy USERNAME/KEY also work.
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=

# ---------- LLM providers ----------
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- GigSim (Phase 2) ----------
GIGSIM_URL=http://localhost:8100
GIGSIM_PORT=8100
GIGSIM_SEED=42
GIGSIM_ERROR_RATE=0.03
GIGSIM_RATE_LIMIT_PER_MIN=60
GIGSIM_RELEASE_INTERVAL_MIN=10
# simulated seconds per real second (60 = one simulated minute per second; 0 = only /admin/tick moves time)
GIGSIM_TIME_SCALE=60
GIGSIM_POLICY_VERSION=v1
# user:token pairs for GigSim bearer auth (one per persona + reviewer)
GIGSIM_TOKENS=ai_ml:dev-token-ai-ml,fullstack:dev-token-fullstack,data_analyst:dev-token-data-analyst,reviewer:dev-token-reviewer
GIGSIM_ADMIN_TOKEN=dev-admin-token
GIGSIM_INCLUDE_HELDOUT=true
# optional LLM rubric for simulated clients (gigsim/config.yaml rubric.kind: llm)
GIGSIM_RUBRIC_BASE_URL=
GIGSIM_RUBRIC_MODEL=
GIGSIM_RUBRIC_API_KEY=

# ---------- MCP servers (Phase 3) ----------
MCP_PORTFOLIO_URL=http://localhost:8201/mcp
MCP_MARKETPLACE_URL=http://localhost:8202/mcp
MCP_WORKSPACE_URL=http://localhost:8203/mcp
# bearer tokens accepted by the MCP servers (user:token,...) and user->persona overrides
MCP_TOKENS=ai_ml:dev-mcp-ai-ml,fullstack:dev-mcp-fullstack,data_analyst:dev-mcp-data-analyst,reviewer:dev-mcp-reviewer
MCP_USER_PERSONAS=reviewer:ai_ml
MCP_RATE_LIMIT_PER_MIN=50
MCP_DATABASE_URL=sqlite:///./mcp.db
GITHUB_PERSONAL_ACCESS_TOKEN=
# local LLM overrides (optional), e.g. GIGBID_STRONG_PROVIDER=ollama GIGBID_STRONG_MODEL=qwen2.5:3b
GIGBID_STRONG_PROVIDER=
GIGBID_STRONG_MODEL=

# ---------- API / auth (Phase 6) ----------
API_URL=http://localhost:8000
# at least 32 random chars: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# agents: rules (deterministic, no LLM) or llm (configured models, rules fallback per node)
GIGBID_AGENT_MODE=rules
# Fernet key: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
REVIEWER_EMAIL=reviewer@example.com
REVIEWER_PASSWORD=change-me

# ---------- Upwork live adapter (Phase 10) ----------
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://localhost:3000/settings/upwork/callback

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Deploy (Phase 12) ----------
PUBLIC_DOMAIN=
