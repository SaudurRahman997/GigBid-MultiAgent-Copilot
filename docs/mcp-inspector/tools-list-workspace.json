{
  "tools": [
    {
      "name": "free_slots",
      "title": "Find free calendar slots",
      "description": "Free slots between start and end (max 14 days), on a 30-minute grid, working hours\n        09:00-17:00 UTC on weekdays. Returns at most 20 slots.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start": {
            "description": "ISO 8601, UTC assumed",
            "maxLength": 40,
            "minLength": 10,
            "title": "Start",
            "type": "string"
          },
          "end": {
            "description": "ISO 8601, UTC assumed",
            "maxLength": 40,
            "minLength": 10,
            "title": "End",
            "type": "string"
          },
          "duration_min": {
            "default": 30,
            "maximum": 240,
            "minimum": 15,
            "title": "Duration Min",
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "free_slotsArguments"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "slots": {
            "items": {
              "$ref": "#/$defs/Slot"
            },
            "title": "Slots",
            "type": "array"
          },
          "timezone": {
            "default": "UTC",
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "slots"
        ],
        "$defs": {
          "Slot": {
            "properties": {
              "start": {
                "title": "Start",
                "type": "string"
              },
              "end": {
                "title": "End",
                "type": "string"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "title": "Slot",
            "type": "object"
          }
        },
        "title": "SlotsResult"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "create_tentative_hold",
      "title": "Create tentative calendar hold",
      "description": "Reserve a slot tentatively (e.g. a proposed interview time). Fails if not free.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start": {
            "description": "ISO 8601, UTC assumed",
            "maxLength": 40,
            "minLength": 10,
            "title": "Start",
            "type": "string"
          },
          "duration_min": {
            "maximum": 240,
            "minimum": 15,
            "title": "Duration Min",
            "type": "integer"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9:_.\\-]+$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "description": "If true, validate and preview only",
            "title": "Dry Run",
            "type": "boolean"
          }
        },
        "required": [
          "start",
          "duration_min",
          "title",
          "idempotency_key"
        ],
        "title": "create_tentative_holdArguments"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "dry_run": {
            "title": "Dry Run",
            "type": "boolean"
          },
          "hold_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hold Id"
          },
          "start": {
            "title": "Start",
            "type": "string"
          },
          "end": {
            "title": "End",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "status": {
            "default": "tentative",
            "title": "Status",
            "type": "string"
          },
          "replayed": {
            "default": false,
            "title": "Replayed",
            "type": "boolean"
          }
        },
        "required": [
          "dry_run",
          "hold_id",
          "start",
          "end",
          "title"
        ],
        "title": "Hold"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "create_email_draft",
      "title": "Create email draft (not sent)",
      "description": "Save an email DRAFT for the freelancer to review. Never sends. Marketplace clients\n        must be contacted on-platform (policy), so use this for the freelancer's own notes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "to": {
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$",
            "title": "To",
            "type": "string"
          },
          "subject": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          },
          "body": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9:_.\\-]+$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "description": "If true, validate and preview only",
            "title": "Dry Run",
            "type": "boolean"
          }
        },
        "required": [
          "to",
          "subject",
          "body",
          "idempotency_key"
        ],
        "title": "create_email_draftArguments"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "dry_run": {
            "title": "Dry Run",
            "type": "boolean"
          },
          "draft_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Draft Id"
          },
          "to": {
            "title": "To",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "body_preview": {
            "title": "Body Preview",
            "type": "string"
          },
          "status": {
            "default": "draft",
            "title": "Status",
            "type": "string"
          },
          "replayed": {
            "default": false,
            "title": "Replayed",
            "type": "boolean"
          }
        },
        "required": [
          "dry_run",
          "draft_id",
          "to",
          "subject",
          "body_preview"
        ],
        "title": "EmailDraft"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
