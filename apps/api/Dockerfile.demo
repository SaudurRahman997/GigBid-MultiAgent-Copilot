# GigBid API, single-process demo hosting (Render / Hugging Face Spaces / any Docker host).
# The agents run against the in-process tool layer (evals/inprocess_mcp.py: same tool names and
# result shapes as the MCP servers) on the synthetic data, so no Postgres, Redis or MCP servers are
# needed. State (runs, drafts, approvals) lives for the life of the process. Build from the repo root:
#   docker build -f apps/api/Dockerfile.demo -t gigbid-api-demo .
# Required env: JWT_SECRET, TOKEN_ENCRYPTION_KEY (Fernet), REVIEWER_EMAIL, REVIEWER_PASSWORD, WEB_ORIGINS.
FROM python:3.12.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    GIGBID_MCP_MODE=inprocess \
    GIGBID_AGENT_MODE=rules \
    API_DATABASE_URL=sqlite:////app/var/api.db \
    PORT=8000

COPY --from=ghcr.io/astral-sh/uv:0.12.0 /uv /usr/local/bin/uv
WORKDIR /app

COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project

COPY agent ./agent
COPY rag ./rag
COPY evals ./evals
COPY apps/__init__.py ./apps/__init__.py
COPY apps/api ./apps/api
COPY mcp_servers ./mcp_servers
COPY data/devset ./data/devset
COPY data/personas ./data/personas
COPY data/policy_pack ./data/policy_pack
COPY data/synthetic ./data/synthetic
COPY data/processed/pricing_stats.parquet data/processed/skill_taxonomy.json ./data/processed/
ENV PATH="/app/.venv/bin:$PATH"

RUN useradd --create-home --uid 10001 gigbid && mkdir -p /app/var && chown -R gigbid /app/var
USER gigbid
EXPOSE 8000
CMD ["sh", "-c", "uvicorn apps.api.main:app --host 0.0.0.0 --port ${PORT}"]
