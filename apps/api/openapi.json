    "/jobs/{job_id}/analyze": {
      "post": {
        "description": "Start a bid thread for this job: analysis -> decision -> (draft -> approval interrupt).",
        "operationId": "analyze_jobs__job_id__analyze_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
